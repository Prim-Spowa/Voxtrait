# Environnement de test — chargé par Vitest (`npm test`) et par la CI
# (`.github/workflows/ci.yml`) ainsi que par Playwright (`npm run test:e2e`).
#
# ST 11.3 : fichier unique et versionné, partagé local / CI, pour que ce qui
# casse en intégration continue se reproduise à l'identique en local.
# Ne contient QUE des secrets de test — ne jamais y placer de secret réel.

# Base de test dédiée (distincte de la base de développement `fandub`).
# Alignée sur le service `postgres` de `docker-compose.yml`.
DATABASE_URL="postgresql://fandub:fandub@localhost:5432/fandub_test?schema=public"

# Secrets de test (>= 32 caractères, jamais utilisés en production).
AUTH_SESSION_SECRET="test-session-secret-not-for-production-0000000000"
MEDIA_URL_SECRET="test-media-url-secret-not-for-production-0000000000"

# Redis local (`docker compose up -d`). BullMQ + sessions + rate limiting.
REDIS_URL="redis://127.0.0.1:6379"

# Stockage objet MinIO local (`docker compose up -d`) — mêmes valeurs que le
# repli par défaut de `src/lib/objectStorage.ts`.
S3_BUCKET="fandub-dev"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
