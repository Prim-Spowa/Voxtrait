// Schéma Prisma — Plateforme communautaire de doublage (Fandub)
// Ce fichier ne modélise, pour l'instant, que ce qui est nécessaire à ST 1.1
// (bibliothèque d'extraits). Les autres tables mentionnées dans
// stories-techniques-site-doublage.md (Utilisateur, Doublage, Signalement, ...)
// seront ajoutées au fil de l'implémentation des stories techniques correspondantes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Statut d'un compte utilisateur — cf. ST 4.1 (création : `ACTIF`) et
// ST 7.2 (modération : `SUSPENDU`, appliqué par `suspendreCompte` dans
// `src/lib/moderation.ts`).
enum StatutUtilisateur {
  ACTIF
  SUSPENDU
}

// Rôle applicatif d'un compte — cf. ST 7.2 « Dashboard de modération »,
// découpage en tâches point 1 : « Ajouter un rôle utilisateur (`utilisateur` /
// `moderateur` / `admin`) ». RBAC minimal (cf. `src/lib/authz.ts`) : la
// hiérarchie est `UTILISATEUR` < `MODERATEUR` < `ADMIN`. `ADMIN` n'ouvre
// aujourd'hui aucun droit supplémentaire par rapport à `MODERATEUR` sur le
// dashboard — la valeur est posée pour éviter une migration d'enum quand une
// action réservée (gérer les rôles, purger des comptes) sera ajoutée.
enum RoleUtilisateur {
  UTILISATEUR
  MODERATEUR
  ADMIN
}

// Type de décision de modération journalisée — cf. ST 7.2, découpage en tâches
// point 4 : « Journalisation des décisions de modération (traçabilité) ».
//
// `RETRAIT_AYANT_DROIT` (ST 7.3 « Procédure notice-and-takedown ») : ajouté pour
// distinguer, dans le journal, un retrait décidé sur demande d'un ayant droit
// d'un retrait de modération classique (`RETRAIT_CONTENU`). Permet le reporting
// séparé des délais de traitement exigé par la procédure notice-and-takedown.
enum ActionModeration {
  REJET_SIGNALEMENT
  RETRAIT_CONTENU
  SUSPENSION_COMPTE
  RETRAIT_AYANT_DROIT
}

// Cycle de vie d'une demande de retrait émise par un ayant droit — cf. ST 7.3
// « Procédure notice-and-takedown », découpage en tâches point 2. `EN_ATTENTE`
// à la réception ; `TRAITEE` quand le contenu a été retiré (statut
// `RETRAIT_AYANT_DROIT`) ; `REJETEE` quand la demande est écartée (contenu déjà
// absent, demande manifestement infondée, hors périmètre). Le passage hors
// `EN_ATTENTE` horodate `dateTraitement` — base du calcul des délais.
enum StatutDemandeRetrait {
  EN_ATTENTE
  TRAITEE
  REJETEE
}

// Visibilité d'un doublage sauvegardé — cf. ST 6.1 « Sauvegarde privée d'un
// doublage », découpage en tâches point 1 : « Modéliser `Doublage` avec champ
// `visibilite` (privé/public) ».
//
// `PRIVEE` (défaut) : seul le propriétaire (`Doublage.utilisateurId`) peut lire
// l'enregistrement — cf. `lireDoublageSauvegarde` dans
// `src/lib/doublageSauvegarde.ts`. `PUBLIC` : réservé à un usage ultérieur
// (partage depuis l'espace privé). Volontairement distinct de la visibilité du
// *job* de génération (`DoublageJob.visibilite`, ST 3.1/3.2, valeurs `privee` /
// `lien_public`) qui gouverne la page publique `/doublage/:id` : ici on décrit
// l'entrée liée au compte, là le lien de partage anonyme.
enum VisibiliteDoublage {
  PRIVEE
  PUBLIC
}

enum OrigineExtrait {
  FR
  US
  JP
}

enum TypeExtrait {
  FILM
  SERIE
  DESSIN_ANIME
}

enum SourceExtrait {
  EMBED
  UPLOAD
}

enum StatutModeration {
  EN_ATTENTE
  VALIDE
  REJETE
  RETRAIT_MODERATION
  RETRAIT_AYANT_DROIT
}

// Type de contenu visé par un signalement — cf. ST 7.1 « Signalement de
// contenu », découpage en tâches point 1 (« contenu_type [extrait/doublage] »).
enum TypeContenuSignale {
  EXTRAIT
  DOUBLAGE
}

// Cycle de vie d'un signalement — cf. ST 7.1 (`EN_ATTENTE` à la création).
// Les transitions relèvent du dashboard de modération (ST 7.2,
// `src/lib/moderation.ts`) : `RETENU` = signalement fondé, le contenu a été
// retiré ou le compte sanctionné ; `REJETE` = signalement écarté. Un
// signalement `EN_ATTENTE` est le seul état sur lequel une action est possible.
enum StatutSignalement {
  EN_ATTENTE
  RETENU
  REJETE
}

// Table `Utilisateur` — cf. ST 4.1 « Inscription », découpage en tâches
// point 1 : « Modéliser la table Utilisateur (email, mot_de_passe_hash,
// date_creation, statut) ».
//
// `email` est l'identifiant de connexion : contrainte d'unicité (garde-fou
// final contre deux inscriptions concurrentes sur la même adresse, cf.
// `registerUtilisateur` dans `src/lib/auth.ts`). Stocké normalisé (trim +
// minuscule) par la couche applicative (`normalizeEmail`).
//
// `motDePasseHash` contient l'algorithme, ses paramètres et le sel, sérialisés
// en une seule chaîne (`scrypt$N$r$p$sel$hash`) — cf. `src/lib/password.ts`.
// Le mot de passe en clair n'est jamais stocké ni journalisé.
model Utilisateur {
  id             String            @id @default(cuid())
  email          String            @unique
  motDePasseHash String            @map("mot_de_passe_hash")
  // Mise à jour ST 4.1 (story technique amendée) : « Modéliser la table
  // Utilisateur (email, mot_de_passe_hash, nom, prénom, âge, date_creation,
  // statut) ». Requis (non nullables) : validés à l'inscription par
  // `collectRegistrationErrors` (nom/prénom non vides, âge entier dans une
  // borne réaliste — cf. `src/lib/authClient.ts`).
  //
  // `age` est un entier simple (pas une date de naissance), conformément à la
  // story : « implique un recalcul manuel chaque année si un usage futur en
  // dépend » (point d'attention explicite, accepté tel quel).
  nom            String
  prenom         String
  age            Int
  statut         StatutUtilisateur @default(ACTIF)
  // ST 7.2 « Dashboard de modération », tâche 1 : rôle applicatif. Défaut
  // `UTILISATEUR` — un compte modérateur est promu manuellement (script/SQL) ou
  // par une future action réservée `ADMIN` (hors périmètre ST 7.2).
  role           RoleUtilisateur   @default(UTILISATEUR)
  dateCreation   DateTime          @default(now()) @map("date_creation")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // ST 4.3 « Acceptation des CGU (fan-usage) », découpage en tâches point 1 :
  // « Ajouter le champ et la version de CGU acceptée en base ».
  //
  // `cguAccepteesLe` : horodatage de l'acceptation — sert de preuve datée
  // (ST 4.3, points d'attention : « Conserver une preuve horodatée de
  // l'acceptation »). `null` = jamais acceptées.
  //
  // `cguVersionAccepteE` : version du texte acceptée (cf. `CGU_VERSION` dans
  // `src/lib/cgu.ts`). Stockée pour pouvoir redemander l'acceptation si les
  // CGU évoluent (ST 4.3, « Choix techniques » : versionnement) — comparaison
  // dans `aAccepteCguActuelles`.
  cguAccepteesLe     DateTime? @map("cgu_acceptees_le")
  cguVersionAcceptee String?   @map("cgu_version_acceptee")

  // ST 5.1 « Import et compression vidéo » — extraits importés par ce compte.
  // Relation inverse de `Extrait.importePar` (cf. plus bas).
  extraitsImportes Extrait[] @relation("ExtraitImportePar")

  // ST 6.1 « Sauvegarde privée d'un doublage » — doublages sauvegardés dans
  // l'espace privé de ce compte. Relation inverse de `Doublage.utilisateur`.
  doublages Doublage[]

  // ST 7.1 « Signalement de contenu » — signalements émis par ce compte
  // (l'auteur d'un signalement est optionnel : les visiteurs non connectés
  // peuvent signaler). Relation inverse de `Signalement.auteur`.
  signalements Signalement[]

  // ST 7.2 « Dashboard de modération » — décisions de modération prises par ce
  // compte (modérateur). Relation inverse de `DecisionModeration.moderateur`.
  decisionsModeration DecisionModeration[]

  // ST 7.3 « Procédure notice-and-takedown » — demandes de retrait closes par
  // ce compte (modérateur). Relation inverse de `DemandeRetrait.traiteePar`.
  demandesRetraitTraitees DemandeRetrait[] @relation("DemandeRetraitTraiteePar")

  @@map("utilisateurs")
}

// Table `DecisionModeration` — cf. ST 7.2 « Dashboard de modération »,
// découpage en tâches point 4 : « Journalisation des décisions de modération
// (traçabilité) ». Une ligne = une action de modérateur (rejet d'un
// signalement, retrait d'un contenu, suspension d'un compte).
//
// Journal **append-only** : jamais modifié ni supprimé après écriture. C'est la
// trace probante d'une décision — utile en cas de contestation d'un
// utilisateur sanctionné (cahier des charges §7) et pour le reporting des
// délais de traitement (ST 7.3).
//
// Les cibles (`contenuType`/`contenuId`, `compteCibleId`) et le lien vers le
// `Signalement` d'origine sont **tous optionnels** : une suspension de compte
// peut être décidée sans signalement rattaché, un rejet ne vise pas de contenu.
// `contenuId`/`compteCibleId` ne sont pas des clés étrangères — comme pour
// `Signalement` (ST 7.1), le contenu retiré peut avoir disparu depuis, et on
// veut conserver la trace même après suppression du compte visé.
model DecisionModeration {
  id            String              @id @default(cuid())
  action        ActionModeration
  moderateurId  String?             @map("moderateur_id")
  moderateur    Utilisateur?        @relation(fields: [moderateurId], references: [id], onDelete: SetNull)
  signalementId String?             @map("signalement_id")
  contenuType   TypeContenuSignale? @map("contenu_type")
  contenuId     String?             @map("contenu_id")
  compteCibleId String?             @map("compte_cible_id")
  // ST 7.3 : demande de retrait d'un ayant droit à l'origine de la décision
  // (renseigné uniquement pour une action `RETRAIT_AYANT_DROIT`). Pas une clé
  // étrangère — même posture que les autres cibles : la trace doit survivre à
  // une éventuelle purge de la demande.
  demandeRetraitId String?          @map("demande_retrait_id")
  /// Commentaire libre du modérateur (motivation de la décision). Optionnel.
  commentaire   String?
  dateCreation  DateTime            @default(now()) @map("date_creation")

  // Journal trié par récence (vue « historique des décisions »).
  @@index([dateCreation])
  // Retrouver les décisions liées à un signalement donné.
  @@index([signalementId])
  // ST 7.3 : reporting des retraits ayant droit (délais de traitement).
  @@index([action, dateCreation])
  @@map("decisions_moderation")
}

// Table `Signalement` — cf. ST 7.1 « Signalement de contenu », découpage en
// tâches point 1 : « Modéliser `Signalement` (contenu_id, contenu_type
// [extrait/doublage], motif, auteur_optionnel, date, statut) ».
//
// Le signalement est **ouvert aux visiteurs non connectés** (cf. cahier des
// charges §3-4) : `auteurId` est nullable. Quand il est renseigné, il pointe
// vers le compte à l'origine du signalement (`onDelete: SetNull` — la
// suppression d'un compte ne fait pas disparaître le signalement, utile au
// suivi de modération).
//
// `contenuId` n'est **pas** une clé étrangère : il peut viser un `Extrait`
// (ST 1.1/5.1) comme un job de doublage (ST 3.1, store en mémoire, pas de
// table). Le rapprochement se fait côté modération (ST 7.2).
//
// `motif` est **obligatoire** (texte libre construit côté client à partir
// d'une catégorie + détails éventuels) — la validation de non-vacuité est
// faite par `src/lib/signalement.ts` et l'endpoint `POST /api/signalements`.
model Signalement {
  id           String             @id @default(cuid())
  contenuType  TypeContenuSignale @map("contenu_type")
  contenuId    String             @map("contenu_id")
  motif        String
  auteurId     String?            @map("auteur_id")
  auteur       Utilisateur?       @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  statut       StatutSignalement  @default(EN_ATTENTE)
  dateCreation DateTime           @default(now()) @map("date_creation")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  // File de modération (ST 7.2) : les signalements en attente, les plus anciens
  // d'abord.
  @@index([statut, dateCreation])
  // Regrouper les signalements visant un même contenu (ST 7.2).
  @@index([contenuType, contenuId])
  @@map("signalements")
}

// Table `DemandeRetrait` — cf. ST 7.3 « Procédure notice-and-takedown »,
// découpage en tâches point 2 : « Formulaire/point de contact « demande de
// retrait » ».
//
// Une ligne = une réclamation d'un ayant droit demandant le retrait d'un
// contenu (`Extrait` ou doublage). Distincte de `Signalement` (ST 7.1) : le
// signalement est un geste communautaire anonyme et bref, la demande de retrait
// est une réclamation juridique nominative qui engage son auteur (déclaration de
// bonne foi, coordonnées vérifiables) et ouvre une obligation de traitement
// tracé (délais — cf. `src/lib/demandeRetraitClient.ts`).
//
// `contenuId` n'est **pas** une clé étrangère (même raison que `Signalement`).
// `traiteePar` : modérateur ayant clos la demande (`onDelete: SetNull` — le
// départ d'un modérateur ne doit pas effacer la trace du traitement).
model DemandeRetrait {
  id           String              @id @default(cuid())
  contenuType  TypeContenuSignale  @map("contenu_type")
  contenuId    String              @map("contenu_id")
  /// Œuvre / droit invoqué (titre du film, de la série…), tel que saisi.
  oeuvre       String
  /// Identité du demandeur (personne physique ou représentant).
  demandeurNom String              @map("demandeur_nom")
  /// Email de contact du demandeur — seul canal de réponse.
  demandeurEmail String            @map("demandeur_email")
  /// Organisation représentée, si applicable.
  demandeurOrganisation String?    @map("demandeur_organisation")
  /// Exposé de la demande (nature des droits, contenu visé).
  motif        String
  /// Case « je déclare de bonne foi être titulaire des droits ou mandaté ».
  /// Obligatoire à `true` pour enregistrer la demande (garde-fou applicatif).
  declarationBonneFoi Boolean      @map("declaration_bonne_foi")
  statut       StatutDemandeRetrait @default(EN_ATTENTE)
  /// Commentaire de clôture du modérateur (motivation, notamment si `REJETEE`).
  commentaireTraitement String?    @map("commentaire_traitement")
  traiteeParId String?             @map("traitee_par_id")
  traiteePar   Utilisateur?        @relation("DemandeRetraitTraiteePar", fields: [traiteeParId], references: [id], onDelete: SetNull)
  dateCreation DateTime            @default(now()) @map("date_creation")
  /// Horodatage du passage hors `EN_ATTENTE` — base du calcul du délai.
  dateTraitement DateTime?         @map("date_traitement")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // File de traitement (les demandes en attente, les plus anciennes d'abord).
  @@index([statut, dateCreation])
  // Rapprocher une demande des signalements / décisions visant le même contenu.
  @@index([contenuType, contenuId])
  @@map("demandes_retrait")
}

// Table `Doublage` — cf. ST 6.1 « Sauvegarde privée d'un doublage », découpage
// en tâches point 1 : « Modéliser `Doublage` avec champ `visibilite`
// (privé/public) ». Champs volontairement limités à ceux listés dans la story
// technique : `utilisateur_id`, `extrait_id`, `fichier_url`, `visibilite`,
// `date_creation`.
//
// L'enregistrement lie un **fichier de doublage déjà généré** (ST 3.1 — aucune
// re-génération : `fichierUrl` recopie l'URL de sortie du job) au **compte** de
// l'utilisateur. Le contrôle d'accès en lecture (« seul le propriétaire peut
// lire un doublage privé ») est appliqué par la couche applicative
// (`lireDoublageSauvegarde`, `src/lib/doublageSauvegarde.ts`) qui vérifie
// `utilisateurId` à CHAQUE lecture (ST 6.1, points d'attention).
//
// `jobId` : id du job de génération (ST 3.1) dont ce doublage est issu.
// Contrainte d'unicité `(utilisateur_id, job_id)` : sauvegarder deux fois le
// même doublage est idempotent (on retrouve l'entrée existante) plutôt que de
// créer des doublons.
//
// `onDelete: Cascade` sur `utilisateur` : la suppression d'un compte emporte
// ses sauvegardes privées (contrairement aux imports en bibliothèque publique,
// cf. `Extrait.importePar` en `SetNull` — un doublage privé n'a de sens que
// rattaché à son propriétaire).
model Doublage {
  id               String             @id @default(cuid())
  utilisateurId    String             @map("utilisateur_id")
  utilisateur      Utilisateur        @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  extraitId        String             @map("extrait_id")
  jobId            String             @map("job_id")
  fichierUrl       String             @map("fichier_url")
  visibilite       VisibiliteDoublage @default(PRIVEE)
  // ST 7.2 « Dashboard de modération », tâche 3 : « retirer contenu (changement
  // de statut `Extrait`/`Doublage`) ». `VALIDE` par défaut ;
  // `RETRAIT_MODERATION` quand un modérateur retire le doublage suite à un
  // signalement fondé (cf. `retirerContenuSignale`, `src/lib/moderation.ts`).
  // Réutilise l'enum `StatutModeration` de `Extrait` (mêmes valeurs de
  // retrait) : un doublage retiré ne doit plus être servi par la page publique
  // `/doublage/:id` ni réapparaître dans l'historique du compte (ST 6.2).
  statutModeration StatutModeration   @default(VALIDE) @map("statut_moderation")
  dateCreation     DateTime           @default(now()) @map("date_creation")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  // Idempotence de la sauvegarde (cf. `sauvegarderDoublage`).
  @@unique([utilisateurId, jobId])
  // Listing de l'espace privé (« mon historique », ST 6.2), le plus récent d'abord.
  @@index([utilisateurId, dateCreation])
  @@map("doublages")
}

// Table `Extrait` — cf. ST 1.1, découpage en tâches, point 1.
model Extrait {
  id        String           @id @default(cuid())
  titre     String
  origine   OrigineExtrait
  type      TypeExtrait
  source    SourceExtrait
  urlSource String           @map("url_source")
  thumbnail String?
  statut    StatutModeration @default(EN_ATTENTE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // ST 5.1 « Import et compression vidéo », découpage en tâches point 4 :
  // « Création de l'entrée bibliothèque avec statut "en attente de
  // modération" ». Renseignés uniquement pour les extraits issus d'un import
  // utilisateur (`source = UPLOAD` via le flux d'import) ; `null` pour les
  // extraits ajoutés par seed/admin.
  //
  //  - `dureeSecondes` : durée réelle de la vidéo, sondée puis validée
  //    ≤ 5 min (cf. `MAX_IMPORT_DURATION_SECONDS`, `src/lib/importClient.ts`) ;
  //  - `importePar` / `importeParId` : compte importateur. `onDelete: SetNull`
  //    — la suppression d'un compte ne supprime pas ses imports déjà en
  //    bibliothèque (la modération reste maîtresse du contenu public, Epic 7).
  dureeSecondes Int?         @map("duree_secondes")
  importeParId  String?      @map("importe_par_id")
  importePar    Utilisateur? @relation("ExtraitImportePar", fields: [importeParId], references: [id], onDelete: SetNull)

  // ST 5.2 « Certification des droits à l'import », découpage en tâches point 1 :
  // « Champ certification_droits lié à l'entrée Extrait (horodatage, référence
  // texte) ». La certification est demandée à CHAQUE import (case à cocher
  // obligatoire) et enregistrée ici, par extrait — preuve individuelle utile
  // en cas de litige (ST 5.2, « Choix techniques »). Distinct de l'acceptation
  // des CGU (ST 4.3), qui est unique par compte.
  //
  //  - `certificationDroitsLe`      : horodatage de la certification ;
  //  - `certificationDroitsVersion` : version du texte certifié (cf.
  //    `CERTIFICATION_DROITS_VERSION`, `src/lib/certificationDroits.ts`).
  //
  // `null` pour les extraits ajoutés par seed/admin (hors flux d'import).
  certificationDroitsLe      DateTime? @map("certification_droits_le")
  certificationDroitsVersion String?   @map("certification_droits_version")

  // cf. ST 1.3 — un extrait peut avoir 0..n lignes de script.
  scriptLignes ScriptLigne[]

  // Index nécessaires à la pagination/filtrage à volume important
  // (cf. ST 1.1, "Points d'attention").
  @@index([statut, origine, type])
  @@index([createdAt])
  // ST 5.1 — liste des imports d'un utilisateur (futur "mon espace", ST 6.x).
  @@index([importeParId])
  @@map("extraits")
}

// Table `ScriptLigne` — cf. ST 1.3 "Synchronisation script/dialogue",
// découpage en tâches, point 1.
//
// Champs volontairement limités à ceux listés dans la story technique
// (extrait_id, texte, timestamp_debut, timestamp_fin). Le composant
// `Prompter` du design system "Doublure arcade"
// (Claude output/Design system Doublure arcade/components/media/Prompter.jsx)
// prévoit aussi un champ `character` (personnage) : absent ici par fidélité
// au périmètre de ST 1.3 — écart signalé en notes de dev pour arbitrage,
// plutôt qu'ajouté silencieusement.
//
// Stockage en base plutôt que fichier sous-titres (SRT/VTT), cf. ST 1.3
// "Choix techniques" : permet la réutilisation directe des timestamps par le
// module d'enregistrement (ST 2.1).
model ScriptLigne {
  id             String   @id @default(cuid())
  extraitId      String   @map("extrait_id")
  extrait        Extrait  @relation(fields: [extraitId], references: [id], onDelete: Cascade)
  texte          String
  timestampDebut Float    @map("timestamp_debut")
  timestampFin   Float    @map("timestamp_fin")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Lecture triée par ordre d'apparition et filtrée par extrait
  // (cf. `listScriptLignes` dans `src/lib/script.ts`).
  @@index([extraitId, timestampDebut])
  @@map("script_lignes")
}
