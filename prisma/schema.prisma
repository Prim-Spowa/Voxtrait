// Schéma Prisma — Plateforme communautaire de doublage (Fandub)
// Ce fichier ne modélise, pour l'instant, que ce qui est nécessaire à ST 1.1
// (bibliothèque d'extraits). Les autres tables mentionnées dans
// stories-techniques-site-doublage.md (Utilisateur, Doublage, Signalement, ...)
// seront ajoutées au fil de l'implémentation des stories techniques correspondantes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrigineExtrait {
  FR
  US
  JP
}

enum TypeExtrait {
  FILM
  SERIE
  DESSIN_ANIME
}

enum SourceExtrait {
  EMBED
  UPLOAD
}

enum StatutModeration {
  EN_ATTENTE
  VALIDE
  REJETE
  RETRAIT_MODERATION
  RETRAIT_AYANT_DROIT
}

// Table `Extrait` — cf. ST 1.1, découpage en tâches, point 1.
model Extrait {
  id        String           @id @default(cuid())
  titre     String
  origine   OrigineExtrait
  type      TypeExtrait
  source    SourceExtrait
  urlSource String           @map("url_source")
  thumbnail String?
  statut    StatutModeration @default(EN_ATTENTE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // cf. ST 1.3 — un extrait peut avoir 0..n lignes de script.
  scriptLignes ScriptLigne[]

  // Index nécessaires à la pagination/filtrage à volume important
  // (cf. ST 1.1, "Points d'attention").
  @@index([statut, origine, type])
  @@index([createdAt])
  @@map("extraits")
}

// Table `ScriptLigne` — cf. ST 1.3 "Synchronisation script/dialogue",
// découpage en tâches, point 1.
//
// Champs volontairement limités à ceux listés dans la story technique
// (extrait_id, texte, timestamp_debut, timestamp_fin). Le composant
// `Prompter` du design system "Doublure arcade"
// (Claude output/Design system Doublure arcade/components/media/Prompter.jsx)
// prévoit aussi un champ `character` (personnage) : absent ici par fidélité
// au périmètre de ST 1.3 — écart signalé en notes de dev pour arbitrage,
// plutôt qu'ajouté silencieusement.
//
// Stockage en base plutôt que fichier sous-titres (SRT/VTT), cf. ST 1.3
// "Choix techniques" : permet la réutilisation directe des timestamps par le
// module d'enregistrement (ST 2.1).
model ScriptLigne {
  id             String   @id @default(cuid())
  extraitId      String   @map("extrait_id")
  extrait        Extrait  @relation(fields: [extraitId], references: [id], onDelete: Cascade)
  texte          String
  timestampDebut Float    @map("timestamp_debut")
  timestampFin   Float    @map("timestamp_fin")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Lecture triée par ordre d'apparition et filtrée par extrait
  // (cf. `listScriptLignes` dans `src/lib/script.ts`).
  @@index([extraitId, timestampDebut])
  @@map("script_lignes")
}
